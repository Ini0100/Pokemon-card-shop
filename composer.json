{
    "name": "inigomunoz/tcg-market",
    "description": "Trading card game e-commerce built with plain PHP and MySQL.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "setup": "php bin/setup.php",
        "import-cards": "php bin/import-cards.php",
        "export-cards": "php bin/export-cards.php",
        "lint": "find src views config public -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
