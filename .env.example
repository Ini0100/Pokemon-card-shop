# Copy this file to `.env` and adjust the values for your environment.

APP_NAME="TCG Market"
APP_ENV=local            # local | production
APP_DEBUG=true
# Absolute public URL used in e-mail links (no trailing slash).
# Leave empty to detect it from the current request.
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tcg_market
DB_USERNAME=root
DB_PASSWORD=

# Minutes a product stays reserved in a cart before returning to stock.
CART_RESERVATION_MINUTES=60

# SMTP settings for account activation e-mails. When MAIL_HOST is empty the
# activation link is written to the PHP error log instead (handy for local dev).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@tcgmarket.test
MAIL_FROM_NAME="TCG Market"
